# Copy this file to .env and fill in real values. NEVER commit .env.

# Long random string used to sign login tokens.
SECRET_KEY=change-me-to-a-long-random-string

# Groq API key for the language model.
GROQ_API_KEY=your-groq-key

# Comma-separated login emails allowed to use admin-only endpoints
# (re-indexing the knowledge base). Leave empty and nobody is admin.
ADMIN_EMAILS=you@example.com

# Needed for live hospital / clinic search. Without it the assistant says search
# is not set up (it never invents hospitals). Enable "Places API" (legacy) in Google Cloud.
GOOGLE_PLACES_API_KEY=your-google-places-key

# Optional
# LOG_LEVEL=INFO
# MAX_MESSAGE_CHARS=2000
