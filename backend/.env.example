# Copy this file to .env and fill in real values. NEVER commit .env.

# Long random string used to sign login tokens.
SECRET_KEY=change-me-to-a-long-random-string

# Groq API key for the language model.
GROQ_API_KEY=your-groq-key

# Comma-separated login emails allowed to use admin-only endpoints
# (re-indexing the knowledge base). Leave empty and nobody is admin.
ADMIN_EMAILS=you@example.com

# Hospital search works WITHOUT any key: it uses free OpenStreetMap data.
# Optional: a Google Places key gives richer listings and is then used first.
# Leave it commented out to use the free source.
# GOOGLE_PLACES_API_KEY=your-google-places-key
# PLACES_PROVIDER=osm   # force the free source even if a Google key exists

# ---- added in the final update -------------------------------------------------

# Key used to encrypt appointment details (name, phone, reason) in the database.
# Set it ONCE and keep it. If you change it, old appointment details become unreadable.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DATA_ENCRYPTION_KEY=change-me-to-another-long-random-string

# Browser addresses allowed to call the API (comma-separated).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 = list the clearly-labelled DEMO partner hospital (a sandbox that confirms instantly).
# Use it for the viva demo. Set to 0 for anything real.
DEMO_PARTNER_ENABLED=1

# 1 = show the /docs API page. Set to 0 when the app is deployed.
ENABLE_DOCS=1

